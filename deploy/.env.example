# Copy to deploy/.env (chmod 600). Never commit the real file.

# Admin HTTP basic auth for /admin/* (creating tenants and API keys).
# Leave either empty to disable every admin route (they return 401).
ADMIN_USER=
ADMIN_PASS=

# Label shown in /health.
HEURCHAIN_INSTANCE_ID=self-hosted

# Only when embedding through an OpenAI-compatible API instead of Ollama.
# OPENAI_API_KEY=

# Only when your Qdrant requires an API key.
# QDRANT_API_KEY=
