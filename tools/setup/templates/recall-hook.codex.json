{
  "client": "codex",
  "file": "$CODEX_HOME/hooks.json",
  "review": "Codex runs a new or changed hook only after you trust it in /hooks. Setup never writes trust state.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{COMMAND}}",
            "timeout": 10,
            "statusMessage": "HeurChain memory recall"
          }
        ]
      }
    ]
  },
  "label": "HeurChain memory recall"
}
