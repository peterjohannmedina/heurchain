{
  "name": "heurchain",
  "version": "3.1.0",
  "description": "Self-hosted HeurChain in one package: the memory broker (0.6.1-oss.1, Go source with a Docker Compose stack), a CLI to install and run it, and agent setup for MCP, the memory skill and automatic recall",
  "keywords": [
    "mcp",
    "heurchain",
    "agent-memory",
    "llm",
    "ai",
    "model-context-protocol",
    "bm25",
    "rag",
    "self-hosted",
    "claude",
    "memory-server",
    "docker-compose",
    "claude-code",
    "codex"
  ],
  "homepage": "https://github.com/peterjohannmedina/heurchain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterjohannmedina/heurchain.git",
    "directory": "npm"
  },
  "bugs": {
    "url": "https://github.com/peterjohannmedina/heurchain/issues"
  },
  "license": "MIT",
  "author": "HeurChain <info@heurchain.com>",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "heurchain": "bin/heurchain.mjs"
  },
  "scripts": {
    "prepack": "node scripts/bundle.mjs"
  },
  "files": [
    "bin/",
    "broker/",
    "deploy/",
    "tools/",
    "skills/",
    "docs/",
    "AGENT_CONFIG.json",
    "AGENT_ONBOARDING.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./AGENT_CONFIG.json": "./AGENT_CONFIG.json",
    "./AGENT_ONBOARDING.md": "./AGENT_ONBOARDING.md",
    "./package.json": "./package.json"
  }
}
